{
  "name": "remotion2filmora",
  "version": "1.0.0",
  "description": "Convert programmatic Remotion React motion graphics into native Wondershare Filmora (WFP) timeline projects with isolated transparent GIF element generation.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "start": "remotion studio src/index.ts",
    "render:elements": "node scripts/render-all-elements.mjs",
    "build:wfp": "python scripts/create_filmora_wfp.py",
    "pipeline": "npm run render:elements && npm run build:wfp",
    "verify": "node scripts/verify_project.cjs"
  },
  "keywords": [
    "remotion",
    "filmora",
    "wfp",
    "wesproj",
    "motion-graphics",
    "react",
    "gif",
    "video-editing",
    "nle",
    "automation"
  ],
  "author": "Tarek Allam",
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0"
  }
}